{
  "name": "jemiq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Da una foto di libri a un catalogo verificabile, pronto per Excel.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "overrides": { "exceljs": { "uuid": "11.1.1" } },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "^0.27.0",
    "fake-indexeddb": "^6.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
