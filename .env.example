# Server only. Never prefix these variables with VITE_.
GEMINI_API_KEY=
# Model for photo recognition; configurable without rebuilding.
GEMINI_MODEL=gemini-3.8-flash
# Optional; a Google Books key can provide a dedicated quota.
GOOGLE_BOOKS_API_KEY=
# Required in production: choose at least 16 random characters. Enter this
# access code in the self-hosted app. Gemini is configured on the server.
JEMIQ_ACCESS_TOKEN=
# Persistent directory for standalone Node. Back up this directory regularly.
JEMIQ_DATA_DIR=.data
# Hosted Sites only: encryption for settings saved through the private UI.
# Generate a random value of at least 32 characters. Do not rotate without migrating saved keys.
SETTINGS_ENCRYPTION_KEY=
# Hosted maintenance token access is off in normal operation.
JEMIQ_SERVICE_ACCESS_ENABLED=false
# Production origin, for example https://jemiq.example.com
APP_ORIGIN=
PORT=3000
# Leave loopback for local development. Set 0.0.0.0 inside a deployed container.
HOST=127.0.0.1
# Set 1 only if exactly one trusted reverse proxy terminates HTTPS.
TRUST_PROXY=0
