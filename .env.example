# Server only. Never prefix these variables with VITE_.
GEMINI_API_KEY=
# Stable image + structured-output model; configurable without rebuilding.
GEMINI_MODEL=gemini-3.8-flash
# Studio: image generation uses a separate model and has its own Google billing.
# The existing GEMINI_API_KEY is used unless a dedicated server key is supplied.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_API_KEY=
# Set false to disable paid image generation while keeping local projects usable.
STUDIO_ENABLED=true
# Optional; a Google Books key can provide a dedicated quota.
GOOGLE_BOOKS_API_KEY=
# Required in production: choose at least 16 random characters. Enter this
# access code in the app, never enter the Gemini key in the browser.
JEMIQ_ACCESS_TOKEN=
# Production origin, for example https://jemiq.example.com
APP_ORIGIN=
PORT=3000
# Leave loopback for local development. Set 0.0.0.0 inside a deployed container.
HOST=127.0.0.1
# Set 1 only if exactly one trusted reverse proxy terminates HTTPS.
TRUST_PROXY=0
