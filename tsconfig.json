{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "allowJs": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "src",
    "server",
    "shared",
    "tests",
    "vite.config.ts",
    "vitest.config.ts",
    "app",
    "db",
    "cloudflare-env.d.ts",
    "next-env.d.ts",
    "vite.client.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "examples"
  ]
}
